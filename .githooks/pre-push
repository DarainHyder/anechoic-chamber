#!/bin/sh
# Blocks private material from reaching the public repo. If Python is missing
# the push fails, because an unchecked push is the unsafe outcome.
python_bin=$(command -v python || command -v python3)
if [ -z "$python_bin" ]; then
  echo "BLOCKED: Python not found, so the privacy check cannot run." >&2
  exit 1
fi
exec "$python_bin" "$(dirname "$0")/../scripts/check_private.py" --pre-push
